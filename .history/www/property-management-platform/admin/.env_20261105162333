# ============================================================
# Docker 环境变量模板 — 开放管理后台
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
#
# 用法（二选一）:
#   一键: bash scripts/deploy.sh    # 幂等：补齐缺失密钥 → 双端 compose up → 建库 → 监控冒烟
#   手工: cd admin
#         cp .env.docker .env
#         php ../scripts/gen_env_keys.php --file=.env --replace-placeholders
#         docker compose up -d
#
# 密钥口径:
#   - change-me* 均为占位符，首次部署时由 gen_env_keys.php 替换为随机密钥
#   - 已存在的真实密钥绝不覆盖（旧密钥保留）；缺失键只做追加
#   - 轮换数据库加密密钥用 scripts/rotate_keys.sh（旧 key 自动写入 ENCRYPTION_PREVIOUS_KEYS）
#   - MySQL 容器的库名/用户/密码默认派生自下方 DB_DATABASE/DB_USERNAME/DB_PASSWORD
#     （单一真源，无需重复配置 MYSQL_*；如需独立覆盖再显式设置 MYSQL_* 键）
#   - .env 含全部密钥，已加入 .gitignore，切勿提交版本库
# 更多可选配置（支付/微信/支付宝/季节等）见 .env.example
# ============================================================

# ── 应用配置 ──
APP_NAME=开放管理后台
APP_DEBUG=false
# 容器对外入口是 nginx（默认 80/443），生产环境改为实际域名
APP_URL=http://localhost
# 容器内监听地址（compose 健康检查与 nginx 反代均指向 8787）
SERVER_LISTEN=http://0.0.0.0:8787
DOCS_ENABLED=false
LOG_LEVEL=info

# ── JWT 认证 ──
# 签名密钥，64 位以上（占位符由生成脚本替换）
JWT_SECRET_KEY=1c83000bc59d19a991dbe3107fd3fa267a9706a031e1dd14965ea4287d9778883f19b638bd8d17f4f9720418dc3e578c
JWT_ALGORITHM=HS256
JWT_DEFAULT_EXPIRE=7200
JWT_REFRESH_EXPIRE=1209600
JWT_ISSUER=open-admin
JWT_AUDIENCE=open-admin
JWT_LEEWAY=60
JWT_STORAGE_TYPE=file
JWT_STORAGE_DATABASE=
JWT_STORAGE_PREFIX=jwt_token:

# ── Hashids ID 加解密 ──
# 口径：admin 与 service 的盐必须不同（有意隔离，一端泄漏不至于对端 hashid 被反解）
HASHIDS_SALT=fbcfa679d6a2adcdc7ba3626db062942
HASHIDS_ALT_SALT=14eefeaf020a704bdd1021cfaacbe55a

# ── Snowflake ID 生成 ──
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1
# 起始时间戳（毫秒），修改会导致已生成 ID 失效
SNOWFLAKE_START_TIMESTAMP=1700000000000

# ── API 传输层加密 ──
ENCRYPTION_KEY=75a953474bbd3af61dbdb52ab5e1bc19
ENCRYPTION_CIPHER=AES-256-CBC
# 初始化向量（IV），CBC 模式需 16 字节，留空使用内置默认
ENCRYPTION_IV=

# ── 数据库存储层加密 ──
# 与传输密钥独立，不可共用
ENCRYPTABLE_KEY=f7148a7cfd53e079324010db819db1db
ENCRYPTABLE_CIPHER=AES-256-CBC
# 历史密钥列表（密钥轮换用），逗号分隔，只增不减
ENCRYPTION_PREVIOUS_KEYS=

# ── 点击验证码（poster-php） ──
POSTER_IMAGE_DRIVER=auto
POSTER_IMAGE_QUALITY=90
POSTER_CAPTCHA_STORAGE=auto
POSTER_CAPTCHA_TTL=300
POSTER_CAPTCHA_MAX_ATTEMPTS=3
POSTER_CAPTCHA_DIFFICULTY=medium

# ── 数据库连接 ──
DB_CONNECTION=mysql
DB_HOST=mysql-9
DB_PORT=3306
DB_DATABASE=management
DB_USERNAME=root
DB_PASSWORD=123456

# ── 默认管理员初始密码（一键部署 deploy.sh 建号用；登录后请立即修改） ──
ADMIN_INITIAL_PASSWORD=Admin@123456

# ── Redis 连接 ──
REDIS_HOST=redis
REDIS_PORT=6379
# 外层 docker-nmp 的共享 redis 容器未设 requirepass，客户端必须留空，否则 AUTH 报错
REDIS_PASSWORD=
REDIS_DATABASE=0

# ── CORS 跨域 ──
# 允许的来源域名，生产环境改为实际前端域名
CORS_ALLOWED_ORIGIN=http://localhost

# ── Session 安全 ──
SESSION_SECURE=true
SESSION_SAME_SITE=Strict

# ── Docker Compose 必填（docker-compose.yml 插值，缺失时空值/未设置会直接报错） ──
# REDIS_PASSWORD 同样被 compose 引用，为必填（见上文）
MYSQL_ROOT_PASSWORD=15dc3cc5743ec7345808e682b5f2c79b
GRAFANA_ADMIN_PASSWORD=be6572779c160b4e1f4e3952

# ── 端口覆盖（可选；同主机双栈时 service 端必须错开，见 service/.env.docker） ──
# NGINX_PORT=80
# NGINX_SSL_PORT=443
# MYSQL_PORT=3306
# REDIS_PORT=6379
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

PAYMENT_ENVIRONMENT=sandboxhttp://localhost:8787/
