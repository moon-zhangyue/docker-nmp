# Add these variables to your .env file for PHP 8.4 support

#
# PHP8.4
#
PHP84_VERSION=8.4
PHP84_HOST_PORT=9001
PHP84_HYPERF1_PORT=9521
PHP84_HYPERF2_PORT=9522
PHP84_PHP_CONF_FILE=./services/php84/php.ini
PHP84_FPM_CONF_FILE=./services/php84/php-fpm.conf
PHP84_LOG_DIR=./logs/php84
PHP84_EXTENSIONS=pdo_mysql,mysqli,mbstring,gd,curl,opcache,redis,zip,soap,bcmath,pcntl,sockets,rdkafka,mongodb 