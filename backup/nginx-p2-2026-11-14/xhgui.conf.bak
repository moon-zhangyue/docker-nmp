# XHGui - xhprof 性能分析数据 GUI
# 访问入口: http://localhost:8142（.env 的 XHGUI_HOST_PORT 已绑定 127.0.0.1，仅本机可达）
# PHP 由独立的 xhgui 容器（PHP 8.1 + ext-mongodb）处理
#
# P0 安全加固：来源白名单 + Basic 认证双层防护。
# 凭据文件 services/nginx/conf.d/.htpasswd 被 conf.d/.gitignore 忽略、不入库。
# 新环境首次部署需重新生成，否则 nginx -t 会因找不到文件而失败：
#   printf 'admin:%s\n' "$(openssl passwd -apr1 '你的密码')" > services/nginx/conf.d/.htpasswd
server {
    listen       8142;
    server_name  localhost;
    root         /www/xhgui/html/webroot;
    index  index.php index.html index.htm;

    access_log /var/log/nginx/xhgui.access.log;
    error_log  /var/log/nginx/xhgui.error.log;

    # 宿主机浏览器经 Docker 网关 172.x 访问，落在 172.16.0.0/12 内；其余来源一律拒绝
    allow 127.0.0.1;
    allow 172.16.0.0/12;
    deny  all;

    auth_basic           "XHGui (restricted)";
    auth_basic_user_file /etc/nginx/conf.d/.htpasswd;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_pass   xhgui:9000;
        include        fastcgi-php.conf;
        include        fastcgi_params;
        # SCRIPT_FILENAME 已由 fastcgi_params:2 提供，原此处重复的一行已删除
    }
}
