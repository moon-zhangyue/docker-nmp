[RABBITMQ]
HOST = rabbitmq
PORT = 5672
USER = myuser
PASSWORD = mypass
VHOST = /
QUEUE_NAME = rabbitmq_queue
EXCHANGE_NAME = my_exchange
ROUTING_KEY = my_routing_key
CONSUMER_TAG = my_consumer_tag
PREFETCH_COUNT = 1
# 启用RabbitMQ发布确认机制，确保消息被正确地发送到交换机
RABBITMQ_PUBLISHER_CONFIRMS = true
# 等待RabbitMQ的发布确认结果，以确保消息传递成功
RABBITMQ_WAIT_FOR_CONFIRM = true
# 设置RabbitMQ发布确认的超时时间，单位为秒。在此时间内未收到确认则视为失败
RABBITMQ_CONFIRM_TIMEOUT = 5.0