[RABBITMQ]
RABBITMQ_HOST = rabbitmq
RABBITMQ_PORT = 5672
RABBITMQ_LOGIN = myuser
RABBITMQ_PASSWORD = mypass
RABBITMQ_VHOST = /
RABBITMQ_QUEUE = rabbitmq_queue
RABBITMQ_EXCHANGE = my_exchange
RABBITMQ_ROUTING_KEY = my_routing_key
RABBITMQ_CONSUMER_TAG = my_consumer_tag
RABBITMQ_PREFETCH_COUNT = 1
RABBITMQ_PUBLISHER_CONFIRMS = true # 启用RabbitMQ发布确认机制，确保消息被正确地发送到交换机
RABBITMQ_WAIT_FOR_CONFIRM = true   # 等待RabbitMQ的发布确认结果，以确保消息传递成功
RABBITMQ_CONFIRM_TIMEOUT = 5.0     # 设置RabbitMQ发布确认的超时时间，单位为秒。在此时间内未收到确认则视为失败

